{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": [],
    "lib": ["ES2022"]
  },
  "include": ["src/domain/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
