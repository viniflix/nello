    },
    {
      "source": "/nutritionist/food-bank",
      "destination": "/index.html"
    },
    {
      "source": "/nutritionist/financial",
      "destination": "/index.html"
    },
    {
      "source": "/nutritionist/agenda",
      "destination": "/index.html"
    },
    {
      "source": "/nutritionist/message-templates",
      "destination": "/index.html"
    },
    {
      "source": "/nutritionist/checkins",
