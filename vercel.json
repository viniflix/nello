    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/status",
      "destination": "/index.html"
    },
    {
      "source": "/termos",
      "destination": "/index.html"
    },
    {
      "source": "/privacidade",
      "destination": "/index.html"
