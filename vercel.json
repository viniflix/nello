    },
    {
      "source": "/patient/registros-clinicos",
      "destination": "/index.html"
    },
    {
      "source": "/patient/add-food/:mealId?",
      "destination": "/index.html"
    },
    {
      "source": "/patient/add-meal",
      "destination": "/index.html"
    },
    {
      "source": "/patient/checkin/:sessionId",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/admin/bugs",
      "destination": "/index.html"
    },
    {
      "source": "/admin/users",
      "destination": "/index.html"
    },
    {
      "source": "/admin/users/:id",
      "destination": "/index.html"
    },
    {
      "source": "/admin/financial",
      "destination": "/index.html"
    },
    {
      "source": "/admin/study",
      "destination": "/index.html"
    },
    {
      "source": "/admin/operations",
      "destination": "/index.html"
    },
    {
      "source": "/admin/security",
      "destination": "/index.html"
    },
    {
      "source": "/admin/verifications",
      "destination": "/index.html"
