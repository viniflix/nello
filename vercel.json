      "source": "/ajuda",
      "destination": "/index.html"
    },
    {
      "source": "/seguranca",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://*.posthog.com https://*.sentry.io; connect-src 'self' data: https://challenges.cloudflare.com https://*.supabase.co wss://*.supabase.co https://*.posthog.com https://*.sentry.io; img-src 'self' data: blob: https://*.supabase.co https://*.shutterstock.com https://*.openfoodfacts.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; media-src 'self' data: blob: https://*.supabase.co; worker-src 'self' blob:; frame-src 'self' https://challenges.cloudflare.com; object-src 'none'; upgrade-insecure-requests;"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, no-transform"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable, no-transform"
        }
      ]
    }
  ]
}
