{
  "extends": ["react-app"],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "error"
  },
  "overrides": [
    {
      "files": ["src/infrastructure/observability/safeLogger.js", "**/*.test.js", "**/*.test.jsx"],
      "rules": { "no-console": "off" }
    },
    {
      "files": ["src/lib/database.types.ts"],
      "rules": {
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": "warn"
      }
    }
  ]
}
